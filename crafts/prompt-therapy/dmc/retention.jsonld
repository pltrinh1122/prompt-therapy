{
  "@context": [
    "https://schema.org",
    {
      "dyad": "urn:dyad:term:"
    }
  ],
  "@id": "urn:dyad:dmc:prompt-therapy/retention",
  "@type": [
    "DefinedTermSet",
    "dyad:DecisionCriterion"
  ],
  "identifier": "retention",
  "name": "When a conversation is expired or deleted",
  "description": "When the store drops a conversation or a kept record, decided by code from the PRD's retention requirements.",
  "dyad:decides": "Is this conversation kept, expired or deleted?",
  "dyad:inputs": [
    "the conversation's state in the store: open, ended, kept",
    "whether the user said yes at the consent step",
    "the retention period the PRD states for kept records",
    "a user's deletion request"
  ],
  "hasDefinedTerm": [
    {
      "@type": "DefinedTerm",
      "termCode": "live",
      "name": "Live",
      "dyad:when": "the session is open",
      "dyad:then": "its turns stay in the store until the session ends"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "expire",
      "name": "Expire at session end",
      "dyad:when": "the session ended, with or without consent",
      "dyad:then": "the turns are dropped; a consented record keeps only the symptom and the canon ids"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "delete",
      "name": "Delete now",
      "dyad:when": "the user asked, or a kept record's retention period ran out",
      "dyad:then": "everything of it is removed from the store"
    }
  ],
  "dyad:precedence": "delete over expire over live",
  "dyad:default": "expire",
  "dyad:judgedBy": {
    "dyad:kind": "mechanical",
    "dyad:implementation": "scripts/store.py"
  },
  "isPartOf": "urn:dyad:craft:prompt-therapy",
  "dyad:home": "playbooks/operate.md",
  "dyad:alsoIn": [
    "rules/product-development.md",
    "docs/prd.md",
    "scripts/store.py"
  ],
  "dyad:owner": "prompt-therapy:product-development"
}

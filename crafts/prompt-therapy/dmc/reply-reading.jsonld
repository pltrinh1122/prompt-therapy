{
  "@context": [
    "https://schema.org",
    {
      "dyad": "urn:dyad:term:"
    }
  ],
  "@id": "urn:dyad:dmc:prompt-therapy/reply-reading",
  "@type": [
    "DefinedTermSet",
    "dyad:DecisionCriterion"
  ],
  "identifier": "reply-reading",
  "name": "How each part of a research reply is read",
  "description": "How each part of a participant's reply is read, so an answer is never put under the wrong number and a stop is never missed.",
  "dyad:decides": "How is this part of the reply read?",
  "dyad:inputs": [
    "the reply, with quoted earlier mail removed",
    "the question numbers asked and still open",
    "the notes and profile proposed"
  ],
  "hasDefinedTerm": [
    {
      "@type": "DefinedTerm",
      "termCode": "stop",
      "name": "A wish to stop",
      "dyad:when": "any wish to stop, such as stop, no more, unsubscribe or leave me alone",
      "dyad:then": "end; it beats every other reading"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "off-scope-content",
      "name": "Private content",
      "dyad:when": "it holds the participant's job, clients or coworkers in private detail, or family, health, money or legal matters, or a client's name, figures, accounts or engagement details",
      "dyad:then": "not read further and not saved"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "numbered-answer",
      "name": "An answer under a question number",
      "dyad:when": "a part opens with a Q number Wren asked",
      "dyad:then": "the answer to that number"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "note-answer",
      "name": "An answer to a proposed note",
      "dyad:when": "a part opens with an N number Wren proposed, or P for the profile, and says yes, no or a change",
      "dyad:then": "save, drop, or propose the change under a new number"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "unlabelled-answer",
      "name": "An answer without a number",
      "dyad:when": "a part with no number that clearly answers one open question; or, when it answers no open question, a new story",
      "dyad:then": "read as that answer, or for a new story give it the next Q number, and name the number in the heard line so a wrong guess can be corrected"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "about-service",
      "name": "A question about the service",
      "dyad:when": "the participant asks about Prompt Therapy itself",
      "dyad:then": "dmc:research-session answers it from the accepted documents"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "for-ideas",
      "name": "A request for what helps",
      "dyad:when": "the participant asks what helps, or for a fix",
      "dyad:then": "dmc:research-session offers, after their own reason"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "other-question",
      "name": "Any other question",
      "dyad:when": "the participant asks anything else",
      "dyad:then": "dmc:research-session escalates it"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "unclear",
      "name": "Cannot be told",
      "dyad:when": "it could answer two numbers, or none can be told",
      "dyad:then": "ask once, in the next email, which number it was for; never guess silently"
    }
  ],
  "dyad:precedence": "stop, then off-scope-content, then numbered and note answers, then the rest",
  "dyad:default": "unclear",
  "dyad:judgedBy": {
    "dyad:kind": "inference",
    "dyad:implementation": "scripts/thread.py"
  },
  "isPartOf": "urn:dyad:craft:prompt-therapy",
  "dyad:home": "playbooks/user-research.md",
  "dyad:owner": "prompt-therapy:product-development"
}

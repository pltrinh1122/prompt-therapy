{
  "@context": [
    "https://schema.org",
    {
      "dyad": "urn:dyad:term:"
    }
  ],
  "@id": "urn:dyad:dmc:prompt-therapy/product-version",
  "@type": [
    "DefinedTermSet",
    "dyad:DecisionCriterion"
  ],
  "identifier": "product-version",
  "name": "The version a change makes",
  "description": "Which part of the craft's version a change moves, so the version says what changed for anyone running the service.",
  "dyad:decides": "Is this change a major, a minor or a patch change, or no change to the version?",
  "dyad:inputs": [
    "the change's diff under crafts/prompt-therapy/",
    "whether a product specification's requirement changed",
    "whether a conversation a user would have changes"
  ],
  "hasDefinedTerm": [
    {
      "@type": "DefinedTerm",
      "termCode": "major",
      "name": "Major: the product changes",
      "dyad:when": "a requirement is removed or changed incompatibly, or a never rule changes",
      "dyad:then": "bump the major part of VERSION"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "minor",
      "name": "Minor: the product grows",
      "dyad:when": "a requirement, a play-book, a decision record or a capability is added and nothing a user relies on changes",
      "dyad:then": "bump the minor part of VERSION"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "patch",
      "name": "Patch: a fix",
      "dyad:when": "a defect is fixed or a text is corrected, with no requirement added or changed",
      "dyad:then": "bump the patch part of VERSION"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "none",
      "name": "No version move",
      "dyad:when": "the change touches nothing under the craft's root",
      "dyad:then": "leave VERSION as it is"
    }
  ],
  "dyad:precedence": "the largest part any one change in the PR moves",
  "dyad:default": "minor",
  "dyad:judgedBy": {
    "dyad:kind": "inference",
    "dyad:implementation": null
  },
  "isPartOf": "urn:dyad:craft:prompt-therapy",
  "dyad:home": "playbooks/product-development.md",
  "dyad:alsoIn": [
    "rules/product-development.md"
  ],
  "dyad:owner": "prompt-therapy:product-development"
}
